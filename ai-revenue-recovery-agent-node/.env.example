PORT=3000
# Local PostgreSQL, or the connection string injected by a Vercel Marketplace
# Postgres integration (for example, Neon). In Vercel, add this as an encrypted
# environment variable for Preview and Production; never commit its value.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/revenue_recovery
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxx
SESSION_SECRET=replace_with_a_long_random_secret
